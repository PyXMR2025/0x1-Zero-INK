{
  "name": {{ site.Title | jsonify }},
  "short_name": "ZeroINK",
  "description": {{ site.Params.description | jsonify }},
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "icons": [
    {
      "src": "/web-app-manifest-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/web-app-manifest-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/web-app-manifest-maskable-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/web-app-manifest-maskable-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "theme_color": "#ffffff",
  "background_color": "#ffffff",
  "display": "standalone",
  "screenshots": [
    {
      "src": "/screenshots/screenshot-desktop.png",
      "sizes": "1920x1080",
      "type": "image/png",
      "form_factor": "wide",
      "label": "0x1 ZeroINK blog post on desktop"
    },
    {
      "src": "/screenshots/screenshot-mobile.png",
      "sizes": "1170x1992",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "0x1 ZeroINK blog post on mobile"
    }
  ]
}
